# Server Configuration
PORT=5001
NODE_ENV=production

# Database Configuration (Option 1: Individual Parameters)
DB_HOST=your-cloud-mysql-host.com
DB_PORT=3306
DB_USER=your_db_username
DB_PASS=your_db_password
DB_NAME=barcode
# Set DB_SSL=true if your cloud MySQL provider requires SSL (e.g., Aiven, PlanetScale, Railway)
DB_SSL=true

# Database Configuration (Option 2: Direct Connection URL)
# If provided, this URL overrides individual DB parameters above:
# DATABASE_URL=mysql://username:password@host:3306/barcode

# Authentication
JWT_SECRET=replace_this_with_a_long_random_secret_for_production

# CORS Configuration
# Set to your Vercel frontend URL (e.g. https://your-erp.vercel.app)
FRONTEND_URL=https://your-erp.vercel.app
# Additional comma-separated origins if needed
CORS_ORIGINS=https://your-erp.vercel.app,http://localhost:3000
